<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote name="pradeep"
            fetch="https://github.com/pradeepdhibar" />

    <remote name="lineage"
            fetch="https://github.com/LineageOS" />

    <!-- crDroid Android 16 local manifest for Realme 8 (nashc). -->

    <!-- Replace upstream projects with nashc forks. -->
    <remove-project name="LineageOS/android_frameworks_opt_telephony" optional="true" />
    <remove-project name="crdroidandroid/android_frameworks_opt_telephony" optional="true" />
    <remove-project name="LineageOS/android_hardware_lineage_interfaces" optional="true" />
    <remove-project name="LineageOS/android_hardware_mediatek" optional="true" />
    <remove-project name="LineageOS/android_hardware_oplus" optional="true" />
    <remove-project name="LineageOS/android_system_netd" optional="true" />
    <remove-project name="crdroidandroid/android_frameworks_base" optional="true" />
    <remove-project name="crdroidandroid/android_frameworks_native" optional="true" />
    <remove-project name="platform/external/selinux" optional="true" />

    <!-- Framework and system sources. -->
    <project
        path="frameworks/base"
        name="android_frameworks_base"
        remote="pradeep"
        revision="f2cc62d8458c1c381f3d2d378c01c416002fb702"
        groups="pdk-cw-fs,pdk-fs,sysui-studio" />

    <project
        path="frameworks/native"
        name="android_frameworks_native"
        remote="pradeep"
        revision="crdroid-16-nashc"
        groups="pdk" />

    <project
        path="external/selinux"
        name="android_external_selinux"
        remote="pradeep"
        revision="crdroid-16-nashc"
        groups="pdk" />

    <project
        path="system/netd"
        name="android_system_netd"
        remote="pradeep"
        revision="crdroid-16-nashc" />

    <!-- Device sources. -->
    <project
        path="device/mediatek/sepolicy_vndr"
        name="android_device_mediatek_sepolicy_vndr"
        remote="pradeep"
        revision="lineage-23.2-nashc" />

    <project
        path="device/realme/nashc"
        name="android_device_realme_nashc"
        remote="pradeep"
        revision="lineage-23.2-nashc" />

    <project
        path="frameworks/opt/telephony"
        name="android_frameworks_opt_telephony"
        remote="pradeep"
        revision="lineage-23.2-nashc" />

    <project
        path="hardware/lineage/interfaces"
        name="android_hardware_lineage_interfaces"
        remote="pradeep"
        revision="lineage-23.2-nashc" />

    <project
        path="hardware/mediatek"
        name="android_hardware_mediatek"
        remote="pradeep"
        revision="lineage-23.2-nashc" />

    <project
        path="hardware/oplus"
        name="android_hardware_oplus"
        remote="pradeep"
        revision="lineage-23.2-nashc" />

    <!-- Kernel. -->
    <project
        path="kernel/realme/nashc"
        name="android_kernel_realme_nashc"
        remote="pradeep"
        revision="4fc865580cdadefc4b97bc7bb1ad96a503105477" />

    <project
        path="vendor/realme/nashc"
        name="android_vendor_realme_nashc"
        remote="pradeep"
        revision="lineage-23.2-nashc" />

    <!-- Legacy LiveDisplay dependency. -->
    <project
        path="hardware/lineage/livedisplay"
        name="android_hardware_lineage_livedisplay"
        remote="lineage"
        revision="05bbbfd180bf8c02b6fb81a7e4b8057868f6e4ba" />

    <!-- Standalone OplusCamera port for nashc -->
    <project
        path="vendor/realme/nashc-opluscamera"
        name="android_vendor_realme_nashc-opluscamera"
        remote="pradeep"
        revision="08a5b97cb5f1b33c3b01cfa4d3054ac1510c2223"
        upstream="lineage-23.2-nashc" />

</manifest>
